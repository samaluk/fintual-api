{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/once.ts",
    "src/main.ts",
    "bin/**/*.mjs"
  ],
  "dynamicallyLoaded": [
    "bin/fintual-goal-performance.graphql"
  ],
  "ignoreDependencies": [
    "@effect/tsgo"
  ],
  "typeAware": {
    "enabled": true,
    "require": "complete",
    "projects": [
      "tsconfig.json"
    ]
  },
  "rules": {
    "private-type-leaks": "error",
    "stale-suppressions": "error"
  },
  "duplicates": {
    "mode": "semantic",
    "near": true,
    "minLines": 8,
    "minTokens": 60,
    "minOccurrences": 3,
    "ignoreImports": true
  },
  "health": {
    "maxCyclomatic": 13,
    "maxCognitive": 15,
    "maxCrap": 30,
    "maxUnitSize": 60,
    "thresholdOverrides": [
      {
        "files": [
          "bin/fallow-ci.mjs"
        ],
        "functions": [
          "auditVerdict",
          "regressionVerdict"
        ],
        "maxCrap": 60,
        "reason": "Repo-tooling orchestrator verdicts with no test coverage by design; complexity is well below the cyclomatic/cognitive ceilings"
      }
    ]
  },
  "boundaries": {
    "zones": [
      { "name": "adapter-actual", "patterns": ["src/actual/**"] },
      { "name": "adapter-fintual", "patterns": ["src/fintual/**"] },
      {
        "name": "shared",
        "patterns": [
          "src/env.ts",
          "src/log.ts",
          "src/logging.ts",
          "src/log-test-fixtures.ts",
          "src/performance-snapshot.ts"
        ]
      },
      { "name": "app", "patterns": ["src/*.ts"] }
    ],
    "rules": [
      { "from": "adapter-actual", "allow": ["shared"] },
      { "from": "adapter-fintual", "allow": ["shared"] },
      { "from": "app", "allow": ["shared", "adapter-actual", "adapter-fintual"] }
    ],
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": ["bin/**", "vitest.config.ts"]
    }
  },
  "audit": {
    "gate": "new-only",
    "typeAware": true,
    "deadCodeBaseline": "fallow-baselines/dead-code.json",
    "healthBaseline": "fallow-baselines/health.json",
    "dupesBaseline": "fallow-baselines/dupes.json"
  }
}
