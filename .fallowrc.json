{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/once.ts",
    "src/main.ts",
    "bin/**/*.mjs"
  ],
  "dynamicallyLoaded": [
    "bin/fintual-goal-performance.graphql"
  ],
  "ignoreDependencies": [
    "@effect/tsgo"
  ],
  "typeAware": {
    "enabled": true,
    "require": "complete",
    "projects": [
      "tsconfig.json"
    ]
  },
  "rules": {
    "private-type-leaks": "warn"
  },
  "duplicates": {
    "mode": "semantic",
    "minLines": 8,
    "minTokens": 60,
    "minOccurrences": 3,
    "ignoreImports": true
  },
  "health": {
    "maxCyclomatic": 13,
    "maxCognitive": 16,
    "maxCrap": 157,
    "maxUnitSize": 60
  },
  "audit": {
    "gate": "new-only",
    "deadCodeBaseline": "fallow-baselines/dead-code.json",
    "healthBaseline": "fallow-baselines/health.json",
    "dupesBaseline": "fallow-baselines/dupes.json"
  }
}
