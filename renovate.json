{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		":disableRateLimiting",
		"helpers:pinGitHubActionDigests"
	],
	"rangeStrategy": "pin",
	"minimumReleaseAge": "1 day",
	"packageRules": [
		{
			"matchPackageNames": [
				"effect",
				"@effect/platform-node",
				"@effect/vitest"
			],
			"groupName": "Effect packages"
		},
		{
			"description": "Keep the Fallow CLI, type-aware companion, and GitHub Action together",
			"matchPackageNames": ["fallow", "fallow-type-aware", "fallow-rs/fallow"],
			"groupName": "Fallow",
			"groupSlug": "fallow",
			"groupSingleUpdates": true
		},
		{
			"matchPackageNames": [
				"@actual-app/api"
			],
			"automerge": true,
			"platformAutomerge": true
		},
		{
			"description": "Keep Pullfrog on major-version tags",
			"matchDepTypes": ["action"],
			"matchPackageNames": ["pullfrog/pullfrog"],
			"pinDigests": false,
			"rangeStrategy": "replace"
		}
	]
}
