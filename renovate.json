{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		":disableRateLimiting",
		"helpers:pinGitHubActionDigests"
	],
	"rangeStrategy": "pin",
	"minimumReleaseAge": "3 days",
	"packageRules": [
		{
			"matchPackageNames": [
				"effect",
				"@effect/platform-node",
				"@effect/vitest"
			],
			"groupName": "Effect packages"
		},
		{
			"description": "Keep the Fallow package and GitHub Action together",
			"matchPackageNames": ["fallow", "fallow-rs/fallow"],
			"groupName": "Fallow",
			"groupSlug": "fallow"
		},
		{
			"matchPackageNames": [
				"@actual-app/api"
			],
			"minimumReleaseAge": "0 days",
			"automerge": true,
			"platformAutomerge": true
		},
		{
			"description": "Keep Pullfrog on major-version tags",
			"matchDepTypes": ["action"],
			"matchPackageNames": ["pullfrog/pullfrog"],
			"pinDigests": false,
			"rangeStrategy": "replace"
		}
	]
}
