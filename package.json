{
	"name": "fintual-api",
	"packageManager": "pnpm@11.25.0",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.19.0",
			"onFail": "download"
		}
	},
	"type": "module",
	"devDependencies": {
		"@effect/tsgo": "0.39.0",
		"@effect/vitest": "4.0.0-rc.112",
		"@types/mailparser": "3.4.6",
		"@types/node": "24.13.3",
		"@vitest/coverage-v8": "4.1.11",
		"fallow": "3.22.0",
		"oxfmt": "0.66.0",
		"oxlint": "1.81.0",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"dependencies": {
		"@actual-app/api": "26.9.0",
		"@effect/platform-node": "4.0.0-rc.112",
		"effect": "4.0.0-rc.112",
		"imapflow": "1.7.8",
		"mailparser": "3.9.20"
	},
	"scripts": {
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc -p tsconfig.json",
		"format": "oxfmt --write src",
		"format:check": "oxfmt --check src",
		"lint": "oxlint --deny-warnings --report-unused-disable-directives src",
		"lint:fix": "oxlint --deny-warnings --fix src",
		"fallow": "fallow",
		"fallow:config": "fallow config",
		"fallow:recommend": "fallow recommend",
		"fallow:status": "fallow type-aware status",
		"fallow:audit": "fallow audit --gate all --coverage coverage/coverage-final.json",
		"fallow:audit:staged": "fallow audit --base HEAD --gate all",
		"fallow:dead-code": "fallow dead-code --fail-on-issues",
		"fallow:dupes": "fallow dupes --fail-on-issues",
		"fallow:health": "fallow health --coverage coverage/coverage-final.json --fail-on-issues",
		"fallow:security": "fallow security",
		"fallow:suppressions": "fallow suppressions",
		"fallow:fix:preview": "fallow fix --dry-run",
		"fallow:fix": "fallow fix --yes",
		"fallow:ci": "pnpm fallow:audit && pnpm fallow:dead-code && pnpm fallow:dupes && pnpm fallow:health",
		"dev": "RUN_MODE=once node src/main.ts",
		"once": "RUN_MODE=once node src/main.ts",
		"schedule": "RUN_MODE=schedule node src/main.ts",
		"capture:har": "sh bin/capture-fintual-har.sh",
		"prepare": "if [ -x node_modules/.bin/effect-tsgo ]; then effect-tsgo patch --typescript; fi"
	}
}
