{
	"name": "fintual-api",
	"packageManager": "pnpm@12.11.2",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.22.0",
			"onFail": "download"
		}
	},
	"type": "module",
	"devDependencies": {
		"@effect/tsgo": "0.51.1",
		"@effect/vitest": "4.0.5",
		"@types/mailparser": "3.9.0",
		"@types/node": "24.19.2",
		"@vitest/coverage-v8": "5.0.4",
		"fallow": "3.33.1",
		"oxfmt": "0.73.0",
		"oxlint": "1.88.0",
		"oxlint-tsgolint": "7.0.2004",
		"typescript": "7.0.2",
		"vitest": "5.0.4"
	},
	"dependencies": {
		"@actual-app/api": "26.10.0",
		"@effect/platform-node": "4.0.5",
		"effect": "4.0.5",
		"imapflow": "2.4.3",
		"mailparser": "3.9.39"
	},
	"scripts": {
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc -p tsconfig.json",
		"format": "oxfmt --write src",
		"format:check": "oxfmt --check src",
		"lint": "oxlint --deny-warnings --report-unused-disable-directives src",
		"lint:fix": "oxlint --deny-warnings --fix src",
		"fallow:audit": "fallow audit --coverage coverage/coverage-final.json",
		"fallow:audit:staged": "fallow audit --base HEAD",
		"fallow:ci": "pnpm fallow:audit && fallow --format human --coverage coverage/coverage-final.json --fail-on-issues",
		"dev": "RUN_MODE=once node src/main.ts",
		"once": "RUN_MODE=once node src/main.ts",
		"schedule": "RUN_MODE=schedule node src/main.ts",
		"capture:har": "sh bin/capture-fintual-har.sh",
		"prepare": "if [ -x node_modules/.bin/effect-tsgo ]; then effect-tsgo patch --typescript --force; fi"
	}
}
