{
	"name": "fintual-api",
	"packageManager": "pnpm@11.21.0",
	"type": "module",
	"devDependencies": {
		"@effect/tsgo": "0.36.4",
		"@effect/vitest": "4.0.0-beta.107",
		"@types/mailparser": "3.4.6",
		"@types/node": "24.13.3",
		"fallow": "3.14.0",
		"oxfmt": "0.63.0",
		"oxlint": "1.78.0",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	},
	"dependencies": {
		"@actual-app/api": "26.8.1",
		"@effect/platform-node": "4.0.0-beta.107",
		"dotenv": "17.4.2",
		"effect": "4.0.0-beta.107",
		"imapflow": "1.6.6",
		"mailparser": "3.9.15"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json",
		"format": "oxfmt --write src",
		"format:check": "oxfmt --check src",
		"lint": "oxlint --deny-warnings --report-unused-disable-directives src",
		"lint:fix": "oxlint --deny-warnings --fix src",
		"fallow": "fallow",
		"fallow:audit": "FALLOW_AUDIT_BASE=origin/main fallow audit",
		"fallow:baseline": "fallow --save-baseline fallow-baselines/dead-code.json || { s=$?; [ $s -eq 1 ] || exit $s; }; fallow health --save-baseline fallow-baselines/health.json --baseline-mode identity || { s=$?; [ $s -eq 1 ] || exit $s; }; fallow dupes --save-baseline fallow-baselines/dupes.json || { s=$?; [ $s -eq 1 ] || exit $s; }",
		"fallow:diagnose": "node bin/diagnose-fallow.mjs",
		"fallow:fix:preview": "fallow fix --dry-run",
		"fallow:fix": "fallow fix --yes",
		"dev": "node src/once.ts",
		"once": "node src/once.ts",
		"schedule": "node src/main.ts",
		"capture:har": "sh bin/capture-fintual-har.sh",
		"prepare": "if [ -x node_modules/.bin/effect-tsgo ]; then effect-tsgo patch --typescript; fi"
	}
}
