{
	"name": "fintual-api",
	"packageManager": "pnpm@12.23.0",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.13.1",
			"onFail": "download"
		}
	},
	"type": "module",
	"devDependencies": {
		"@actual-app/crdt": "3.1.4",
		"@effect/tsgo": "0.73.4",
		"@effect/vitest": "4.1.5",
		"@interfere/landmines": "0.3.1",
		"@types/mailparser": "3.9.0",
		"@types/node": "26.6.10",
		"@vitest/coverage-v8": "5.1.1",
		"fallow": "3.48.0",
		"fallow-type-aware": "3.48.0",
		"msw": "3.0.7",
		"oxfmt": "0.80.0",
		"oxlint": "1.95.0",
		"oxlint-tsgolint": "7.0.2008",
		"typescript": "7.0.2",
		"vitest": "5.1.1"
	},
	"dependencies": {
		"@actual-app/api": "26.11.0",
		"@effect/platform-node": "4.1.5",
		"effect": "4.1.5",
		"imapflow": "2.12.2",
		"mailparser": "3.15.0"
	},
	"scripts": {
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc -p tsconfig.json",
		"format": "oxfmt --write src",
		"format:check": "oxfmt --check src",
		"lint": "oxlint --deny-warnings --report-unused-disable-directives src",
		"lint:fix": "oxlint --deny-warnings --fix src",
		"fallow:audit": "fallow audit --coverage coverage/coverage-final.json",
		"fallow:audit:staged": "fallow audit --staged --quiet",
		"fallow:ci": "pnpm fallow:audit && fallow --format human --coverage coverage/coverage-final.json --fail-on-issues",
		"dev": "RUN_MODE=once node src/main.ts",
		"once": "RUN_MODE=once node src/main.ts",
		"schedule": "RUN_MODE=schedule node src/main.ts",
		"capture:har": "sh bin/capture-fintual-har.sh",
		"prepare": "if [ -x node_modules/.bin/effect-tsgo ]; then effect-tsgo patch --typescript --force; fi"
	}
}
