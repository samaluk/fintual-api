{
	"name": "fintual-api",
	"packageManager": "pnpm@11.21.0",
	"type": "module",
	"devDependencies": {
		"@effect/tsgo": "0.36.4",
		"@effect/vitest": "4.0.0-rc.108",
		"@types/mailparser": "3.4.6",
		"@types/node": "24.13.3",
		"@vitest/coverage-v8": "4.1.10",
		"fallow": "3.16.0",
		"oxfmt": "0.63.0",
		"oxlint": "1.78.0",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	},
	"dependencies": {
		"@actual-app/api": "26.8.1",
		"@effect/platform-node": "4.0.0-rc.108",
		"dotenv": "17.4.2",
		"effect": "4.0.0-rc.108",
		"imapflow": "1.7.0",
		"mailparser": "3.9.15"
	},
	"scripts": {
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc -p tsconfig.json",
		"format": "oxfmt --write src",
		"format:check": "oxfmt --check src",
		"lint": "oxlint --deny-warnings --report-unused-disable-directives src",
		"lint:fix": "oxlint --deny-warnings --fix src",
		"fallow": "fallow",
		"fallow:config": "fallow config",
		"fallow:recommend": "fallow recommend",
		"fallow:status": "fallow type-aware status",
		"fallow:audit": "if [ -f coverage/coverage-final.json ]; then FALLOW_AUDIT_BASE=origin/main fallow audit --coverage coverage/coverage-final.json; else FALLOW_AUDIT_BASE=origin/main fallow audit; fi",
		"fallow:audit:staged": "if [ -f coverage/coverage-final.json ]; then fallow audit --base HEAD --coverage coverage/coverage-final.json; else fallow audit --base HEAD; fi",
		"fallow:dead-code": "fallow --baseline fallow-baselines/dead-code.json --fail-on-issues",
		"fallow:dupes": "fallow dupes --baseline fallow-baselines/dupes.json --fail-on-issues",
		"fallow:health": "fallow health --coverage coverage/coverage-final.json --baseline fallow-baselines/health.json --baseline-mode identity --fail-on-issues",
		"fallow:security": "fallow security",
		"fallow:suppressions": "fallow suppressions",
		"fallow:regression": "fallow --fail-on-regression --regression-baseline fallow-baselines/regression.json --coverage coverage/coverage-final.json",
		"fallow:baseline:update": "node bin/fallow-baseline.mjs update",
		"fallow:baseline:check": "node bin/fallow-baseline.mjs check",
		"fallow:fix:preview": "fallow fix --dry-run",
		"fallow:fix": "fallow fix --yes",
		"fallow:ci": "node bin/fallow-ci.mjs",
		"fallow:skill:sync": "node bin/sync-fallow-skill.mjs",
		"dev": "node src/once.ts",
		"once": "node src/once.ts",
		"schedule": "node src/main.ts",
		"capture:har": "sh bin/capture-fintual-har.sh",
		"prepare": "if [ -x node_modules/.bin/effect-tsgo ]; then effect-tsgo patch --typescript; fi"
	}
}
