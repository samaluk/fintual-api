amends "package://github.com/jdx/hk/releases/download/v1.54.1/hk@1.54.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.54.1/hk@1.54.1#/Builtins.pkl"

local sourceGlobs = List("src/**/*.ts")

local sourceChecks = new Mapping<String, Step> {
    ["oxfmt"] = (Builtins.oxfmt) {
        glob = sourceGlobs
        prefix = "pnpm exec"
        check_first = true
        // These built-in fixtures cannot resolve repo-local pnpm binaries from their temp dirs.
        tests = new Mapping<String, StepTest> {}
    }
    ["oxlint"] = (Builtins.ox_lint) {
        glob = sourceGlobs
        prefix = "pnpm exec"
        check_first = true
        // These built-in fixtures cannot resolve repo-local pnpm binaries from their temp dirs.
        tests = new Mapping<String, StepTest> {}
    }
}

// Fast changed/staged-code audit: rejects every Fallow finding in the staged
// diff before the commit is created. Pre-commit only; the coverage-aware,
// project-wide gate runs at pre-push via fallow:ci.
local stagedAudit = new Mapping<String, Step> {
    ["fallow-staged"] {
        check = new Command {
            argv = List("pnpm", "run", "fallow:audit:staged")
        }
    }
}

local projectChecks = new Mapping<String, Step> {
    ...sourceChecks
    ["typecheck"] {
        check = new Command {
            argv = List("pnpm", "run", "typecheck")
        }
    }
    ["test"] {
        check = new Command {
            argv = List("pnpm", "run", "test:coverage")
        }
    }
    ["fallow"] {
        check = new Command {
            argv = List("pnpm", "run", "fallow:ci")
        }
        depends = List("test")
    }
}

hooks {
    ["commit-msg"] {
        steps = new Mapping<String, Step> {
            ["conventional-commit"] = Builtins.check_conventional_commit
        }
    }
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = new Mapping<String, Step> {
            ...sourceChecks
            ...stagedAudit
        }
    }
    ["pre-push"] {
        steps = projectChecks
    }
    ["fix"] {
        fix = true
        steps = sourceChecks
    }
    ["check"] {
        steps = projectChecks
    }
}
